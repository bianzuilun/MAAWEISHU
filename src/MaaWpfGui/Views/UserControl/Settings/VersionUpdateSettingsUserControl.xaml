<UserControl
    x:Class="MaaWpfGui.Views.UserControl.Settings.VersionUpdateSettingsUserControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="clr-namespace:CalcBinding;assembly=CalcBinding"
    xmlns:controls="clr-namespace:MaaWpfGui.Styles.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:settings_vms="clr-namespace:MaaWpfGui.ViewModels.UserControl.Settings"
    d:Background="White"
    d:DataContext="{d:DesignInstance {x:Type settings_vms:VersionUpdateSettingsUserControlModel}}"
    d:DesignWidth="540"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <controls:GlobalConfigTip Grid.Row="0" />
        <StackPanel
            Grid.Row="1"
            HorizontalAlignment="Center"
            VerticalAlignment="Top">
            <Grid HorizontalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <Border
                    Grid.Row="0"
                    Grid.Column="0"
                    Margin="0,5,0,5"
                    Background="#555555"
                    CornerRadius="3,0,0,3"
                    Visibility="{c:Binding 'UiVersion == CoreVersion'}">
                    <TextBlock
                        Padding="5,3,5,3"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        hc:FloatingBlock.Content="{Binding UiVersion}"
                        Foreground="White"
                        PreviewMouseDown="MaaVersionClick"
                        Text="{DynamicResource MaaVersion}"
                        TextWrapping="Wrap" />
                </Border>
                <Border
                    Grid.Row="0"
                    Grid.Column="1"
                    Margin="0,5,0,5"
                    hc:FloatingBlock.Content="{Binding UiVersion}"
                    Background="#6969AA"
                    CornerRadius="0,3,3,0"
                    PreviewMouseDown="MaaVersionClick"
                    Visibility="{c:Binding 'UiVersion == CoreVersion'}">
                    <TextBlock
                        Padding="5,3,5,3"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        d:MinWidth="50"
                        Foreground="White"
                        Text="{Binding UiVersionDisplay, Mode=OneWay}"
                        TextWrapping="Wrap" />
                </Border>
                <Border
                    Grid.Row="1"
                    Grid.Column="0"
                    Margin="0,5,0,5"
                    Background="#555555"
                    CornerRadius="3,0,0,3"
                    Visibility="{c:Binding 'UiVersion != CoreVersion'}">
                    <TextBlock
                        Padding="5,3,5,3"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        hc:FloatingBlock.Content="{Binding UiVersion}"
                        Foreground="White"
                        PreviewMouseDown="UiVersionClick"
                        Text="{DynamicResource UiVersion}"
                        TextWrapping="Wrap" />
                </Border>
                <Border
                    Grid.Row="1"
                    Grid.Column="1"
                    Margin="0,5,0,5"
                    hc:FloatingBlock.Content="{Binding UiVersion}"
                    Background="#6969AA"
                    CornerRadius="0,3,3,0"
                    PreviewMouseDown="UiVersionClick"
                    Visibility="{c:Binding 'UiVersion != CoreVersion'}">
                    <TextBlock
                        Padding="5,3,5,3"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        d:MinWidth="50"
                        Foreground="White"
                        Text="{Binding UiVersionDisplay, Mode=OneWay}"
                        TextWrapping="Wrap" />
                </Border>
                <Border
                    Grid.Row="2"
                    Grid.Column="0"
                    Margin="0,5,0,5"
                    Background="#555555"
                    CornerRadius="3,0,0,3"
                    Visibility="{c:Binding 'UiVersion != CoreVersion'}">
                    <TextBlock
                        Padding="5,3,5,3"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        hc:FloatingBlock.Content="{Binding CoreVersion}"
                        Foreground="White"
                        PreviewMouseDown="CoreVersionClick"
                        Text="{DynamicResource CoreVersion}"
                        TextWrapping="Wrap" />
                </Border>
                <Border
                    Grid.Row="2"
                    Grid.Column="1"
                    Margin="0,5,0,5"
                    hc:FloatingBlock.Content="{Binding CoreVersion}"
                    Background="#6969AA"
                    CornerRadius="0,3,3,0"
                    PreviewMouseDown="CoreVersionClick"
                    Visibility="{c:Binding 'UiVersion != CoreVersion'}">
                    <TextBlock
                        Padding="5,3,5,3"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        d:MinWidth="50"
                        Foreground="White"
                        Text="{Binding CoreVersionDisplay, Mode=OneWay}"
                        TextWrapping="Wrap" />
                </Border>
                <Border
                    Grid.Row="3"
                    Grid.Column="0"
                    Margin="0,5,0,5"
                    Background="#555555"
                    CornerRadius="3,0,0,3">
                    <TextBlock
                        Padding="5,3,5,3"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        hc:FloatingBlock.Content="{Binding ResourceVersion}"
                        Foreground="White"
                        PreviewMouseDown="ResourceVersionClick"
                        Text="{DynamicResource ResourceVersion}"
                        TextWrapping="Wrap" />
                </Border>
                <Border
                    Grid.Row="3"
                    Grid.Column="1"
                    Margin="0,5,0,5"
                    hc:FloatingBlock.Content="{Binding ResourceVersion}"
                    Background="#6969AA"
                    CornerRadius="0,3,3,0"
                    PreviewMouseDown="ResourceVersionClick">
                    <TextBlock
                        Padding="5,3,5,3"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        d:MinWidth="50"
                        Foreground="White"
                        Text="{Binding ResourceVersion, Mode=OneWay}"
                        TextWrapping="Wrap" />
                </Border>
            </Grid>

            <Grid HorizontalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition />
                </Grid.RowDefinitions>

                <Border
                    Grid.Row="0"
                    Grid.Column="0"
                    Margin="0,5,0,5"
                    Background="#555555"
                    CornerRadius="3,0,0,3">
                    <TextBlock
                        Padding="5,3,5,3"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        hc:FloatingBlock.Content="{Binding BuildDateTimeCurrentCultureString}"
                        Foreground="White"
                        PreviewMouseDown="MaaVersionClick"
                        Text="{DynamicResource BuildDateTime}"
                        TextWrapping="Wrap" />
                </Border>
                <Border
                    Grid.Row="0"
                    Grid.Column="1"
                    Margin="0,5,0,5"
                    hc:FloatingBlock.Content="{Binding BuildDateTimeCurrentCultureString}"
                    Background="#6969AA"
                    CornerRadius="0,3,3,0"
                    PreviewMouseDown="MaaVersionClick">
                    <TextBlock
                        Padding="5,3,5,3"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        d:MinWidth="50"
                        Foreground="White"
                        Text="{Binding BuildDateTimeCurrentCultureString, Mode=OneWay}"
                        TextWrapping="Wrap" />
                </Border>

                <Border
                    Grid.Row="1"
                    Grid.Column="0"
                    Margin="0,5,0,5"
                    Background="#555555"
                    CornerRadius="3,0,0,3">
                    <TextBlock
                        Padding="5,3,5,3"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        hc:FloatingBlock.Content="{Binding ResourceDateTimeCurrentCultureString}"
                        Foreground="White"
                        PreviewMouseDown="ResourceVersionClick"
                        Text="{DynamicResource ResourceDateTime}"
                        TextWrapping="Wrap" />
                </Border>
                <Border
                    Grid.Row="1"
                    Grid.Column="1"
                    Margin="0,5,0,5"
                    hc:FloatingBlock.Content="{Binding ResourceDateTimeCurrentCultureString}"
                    Background="#6969AA"
                    CornerRadius="0,3,3,0"
                    PreviewMouseDown="ResourceVersionClick">
                    <TextBlock
                        Padding="5,3,5,3"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        d:MinWidth="50"
                        Foreground="White"
                        Text="{Binding ResourceDateTimeCurrentCultureString, Mode=OneWay}"
                        TextWrapping="Wrap" />
                </Border>
            </Grid>

            <ComboBox
                Width="130"
                Margin="0,10,0,0"
                HorizontalAlignment="Center"
                HorizontalContentAlignment="Center"
                Background="Transparent"
                BorderThickness="0"
                DisplayMemberPath="Display"
                ItemsSource="{Binding ProxyTypeList}"
                SelectedValue="{Binding ProxyType}"
                SelectedValuePath="Value" />
            <hc:TextBox
                Width="150"
                Margin="0,0,0,5"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                hc:InfoElement.Placeholder="&lt;IP&gt;:&lt;Port&gt;"
                InputMethod.IsInputMethodEnabled="False"
                Text="{Binding Proxy}" />
        </StackPanel>
    </Grid>
</UserControl>
